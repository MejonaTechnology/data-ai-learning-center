---
// CareerPathDiagram.astro - Professional Career Paths Flowchart
// Exact alignment with CSS Grid positioning
---

<section class="career-paths-diagram relative py-16 sm:py-20 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
        Data & AI Career Paths
      </h2>
      <p class="text-lg text-slate-600 max-w-3xl mx-auto">
        Navigate your journey from foundations to specialization with our structured learning paths
      </p>
    </div>

    <!-- Career Paths Flowchart with Precise Grid -->
    <div class="relative">
      
      <!-- CSS Grid Container for Precise Positioning -->
      <div class="diagram-grid">
        
        <!-- Row 1: Data Foundation Track -->
        <div class="foundation-row">
          <div class="track-card foundation-track" id="foundation">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            <h3 class="track-title">Data Foundation Track</h3>
            <p class="track-duration">2 months</p>
          </div>
        </div>

        <!-- Connection Layer 1 -->
        <div class="connections-layer">
          <svg class="connection-svg" viewBox="0 0 1000 100">
            <!-- Foundation to 4 tracks - using exact grid positions -->
            <line x1="500" y1="0" x2="500" y2="30" stroke="#3b82f6" stroke-width="3"/>
            <line x1="125" y1="30" x2="875" y2="30" stroke="#3b82f6" stroke-width="3"/>
            <line x1="125" y1="30" x2="125" y2="70" stroke="#3b82f6" stroke-width="3"/>
            <line x1="375" y1="30" x2="375" y2="70" stroke="#3b82f6" stroke-width="3"/>
            <line x1="625" y1="30" x2="625" y2="70" stroke="#3b82f6" stroke-width="3"/>
            <line x1="875" y1="30" x2="875" y2="70" stroke="#3b82f6" stroke-width="3"/>
            
            <polygon points="120,70 130,70 125,80" fill="#3b82f6"/>
            <polygon points="370,70 380,70 375,80" fill="#3b82f6"/>
            <polygon points="620,70 630,70 625,80" fill="#3b82f6"/>
            <polygon points="870,70 880,70 875,80" fill="#3b82f6"/>
          </svg>
        </div>

        <!-- Row 2: Four Main Tracks -->
        <div class="level1-row">
          <div class="track-card analytics-track" id="bi-analyst">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <h3 class="track-title">BI Analyst Track</h3>
            <p class="track-duration">3 months</p>
          </div>

          <div class="track-card engineering-track" id="data-engineer">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
              </svg>
            </div>
            <h3 class="track-title">Data Engineer Track</h3>
            <p class="track-duration">3 months</p>
          </div>

          <div class="track-card science-track" id="data-science">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </div>
            <h3 class="track-title">Data Science Track</h3>
            <p class="track-duration">3 months</p>
          </div>

          <div class="track-card ai-foundation-track" id="ai-foundation">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="track-title">AI Foundation Track</h3>
            <p class="track-duration">2 months</p>
          </div>
        </div>

        <!-- Connection Layer 2 -->
        <div class="connections-layer">
          <svg class="connection-svg" viewBox="0 0 1000 100">
            <!-- BI + Data Engineer → Capstone DE (both to position 1) -->
            <line x1="125" y1="0" x2="125" y2="30" stroke="#059669" stroke-width="3"/>
            <line x1="375" y1="0" x2="375" y2="30" stroke="#059669" stroke-width="3"/>
            <line x1="125" y1="30" x2="375" y2="30" stroke="#059669" stroke-width="3"/>
            <line x1="250" y1="30" x2="125" y2="70" stroke="#059669" stroke-width="3"/>
            <polygon points="120,70 130,70 125,80" fill="#059669"/>
            
            <!-- Data Science → Machine Learning (straight down from pos 3 to pos 2) -->
            <line x1="625" y1="0" x2="625" y2="40" stroke="#7c3aed" stroke-width="3"/>
            <line x1="625" y1="40" x2="375" y2="70" stroke="#7c3aed" stroke-width="3"/>
            <polygon points="370,70 380,70 375,80" fill="#7c3aed"/>
            
            <!-- AI Foundation → Gen AI + AI Engineer (pos 4 to pos 3&4) -->
            <line x1="875" y1="0" x2="875" y2="30" stroke="#ea580c" stroke-width="3"/>
            <line x1="625" y1="30" x2="875" y2="30" stroke="#ea580c" stroke-width="3"/>
            <line x1="625" y1="30" x2="625" y2="70" stroke="#ea580c" stroke-width="3"/>
            <line x1="875" y1="30" x2="875" y2="70" stroke="#ea580c" stroke-width="3"/>
            <polygon points="620,70 630,70 625,80" fill="#ea580c"/>
            <polygon points="870,70 880,70 875,80" fill="#ea580c"/>
          </svg>
        </div>

        <!-- Row 3: Second Level Tracks -->
        <div class="level2-row">
          <div class="track-card capstone-de">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <h3 class="track-title">Capstone Project DE</h3>
            <p class="track-duration">Portfolio Project</p>
          </div>

          <div class="track-card ml-track">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="track-title">Machine Learning Track</h3>
            <p class="track-duration">3 months</p>
          </div>

          <div class="track-card gen-ai-track">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="track-title">Gen AI Engineer Track</h3>
            <p class="track-duration">3 months</p>
          </div>

          <div class="track-card ai-engineer-track">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
              </svg>
            </div>
            <h3 class="track-title">AI Engineer Track</h3>
            <p class="track-duration">3 months</p>
          </div>
        </div>

        <!-- Connection Layer 3 -->
        <div class="connections-layer">
          <svg class="connection-svg" viewBox="0 0 1000 100">
            <!-- Machine Learning → Capstone ML (pos 2 to center-left) -->
            <line x1="375" y1="0" x2="375" y2="40" stroke="#7c3aed" stroke-width="3"/>
            <line x1="375" y1="40" x2="375" y2="70" stroke="#7c3aed" stroke-width="3"/>
            <polygon points="370,70 380,70 375,80" fill="#7c3aed"/>
            
            <!-- Gen AI + AI Engineer → Capstone AI (pos 3&4 to center-right) -->
            <line x1="625" y1="0" x2="625" y2="30" stroke="#ea580c" stroke-width="3"/>
            <line x1="875" y1="0" x2="875" y2="30" stroke="#ea580c" stroke-width="3"/>
            <line x1="625" y1="30" x2="875" y2="30" stroke="#ea580c" stroke-width="3"/>
            <line x1="750" y1="30" x2="625" y2="70" stroke="#ea580c" stroke-width="3"/>
            <polygon points="620,70 630,70 625,80" fill="#ea580c"/>
          </svg>
        </div>

        <!-- Row 4: Final Capstone Projects -->
        <div class="final-row">
          <div class="spacer"></div>
          
          <div class="track-card capstone-ml">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="track-title">Capstone Project ML</h3>
            <p class="track-duration">Portfolio Project</p>
          </div>

          <div class="track-card capstone-ai">
            <div class="track-icon">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="track-title">Capstone Project AI</h3>
            <p class="track-duration">Portfolio Project</p>
          </div>
          
          <div class="spacer"></div>
        </div>
      </div>
    </div>

    <!-- Legend -->
    <div class="mt-16 bg-slate-50 rounded-2xl p-8">
      <h3 class="text-xl font-bold text-slate-900 mb-6 text-center">Learning Path Legend</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex items-center gap-3">
          <div class="w-4 h-4 bg-blue-500 rounded"></div>
          <span class="text-sm font-medium text-slate-700">Foundation Level</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-4 h-4 bg-green-600 rounded"></div>
          <span class="text-sm font-medium text-slate-700">Analytics & Engineering</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-4 h-4 bg-purple-600 rounded"></div>
          <span class="text-sm font-medium text-slate-700">Data Science & ML</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-4 h-4 bg-orange-600 rounded"></div>
          <span class="text-sm font-medium text-slate-700">AI Specialization</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .career-paths-diagram {
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  }

  .diagram-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .foundation-row,
  .level1-row,
  .level2-row,
  .final-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .foundation-row {
    grid-template-columns: 1fr 1fr 1fr 1fr;
    justify-items: center;
  }

  .foundation-row .track-card {
    grid-column: 2 / 4;
  }

  .final-row .spacer {
    grid-column: span 1;
  }

  .connections-layer {
    height: 80px;
    margin: 0;
    position: relative;
  }

  .connection-svg {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
  }

  .track-card {
    @apply bg-white rounded-xl border border-slate-200 p-6 text-center shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 hover:border-slate-300;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .track-icon {
    @apply w-12 h-12 rounded-xl flex items-center justify-center mb-3 transition-all duration-300;
  }

  .track-title {
    @apply font-bold text-slate-800 text-sm sm:text-base mb-2;
  }

  .track-duration {
    @apply text-xs sm:text-sm text-slate-600 font-medium;
  }

  /* Foundation Track */
  .foundation-track .track-icon {
    @apply bg-blue-100 text-blue-600;
  }
  .foundation-track:hover .track-icon {
    @apply bg-blue-200;
  }

  /* Analytics & Engineering Tracks */
  .analytics-track .track-icon,
  .engineering-track .track-icon {
    @apply bg-green-100 text-green-600;
  }
  .analytics-track:hover .track-icon,
  .engineering-track:hover .track-icon {
    @apply bg-green-200;
  }

  /* Data Science & ML Tracks */
  .science-track .track-icon,
  .ml-track .track-icon {
    @apply bg-purple-100 text-purple-600;
  }
  .science-track:hover .track-icon,
  .ml-track:hover .track-icon {
    @apply bg-purple-200;
  }

  /* AI Foundation & Advanced AI Tracks */
  .ai-foundation-track .track-icon,
  .gen-ai-track .track-icon,
  .ai-engineer-track .track-icon {
    @apply bg-orange-100 text-orange-600;
  }
  .ai-foundation-track:hover .track-icon,
  .gen-ai-track:hover .track-icon,
  .ai-engineer-track:hover .track-icon {
    @apply bg-orange-200;
  }

  /* Capstone Projects */
  .capstone-de .track-icon {
    @apply bg-green-100 text-green-600;
  }
  .capstone-de:hover .track-icon {
    @apply bg-green-200;
  }

  .capstone-ml .track-icon {
    @apply bg-purple-100 text-purple-600;
  }
  .capstone-ml:hover .track-icon {
    @apply bg-purple-200;
  }

  .capstone-ai .track-icon {
    @apply bg-orange-100 text-orange-600;
  }
  .capstone-ai:hover .track-icon {
    @apply bg-orange-200;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .foundation-row,
    .level1-row,
    .level2-row,
    .final-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .foundation-row .track-card {
      grid-column: 1;
    }
    
    .final-row .spacer {
      display: none;
    }
    
    .connections-layer {
      display: none;
    }
    
    .track-card {
      min-height: 120px;
    }
  }

  /* Animation for connection lines */
  svg line {
    animation: pulse-line 3s ease-in-out infinite;
  }

  @keyframes pulse-line {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }
</style>