                    href="mailto:social@codestreet.co.in"
                    class="text-primary-600 hover:text-primary-700"
                    >social@codestreet.co.in</a
                  >
                </p>
                <p class="text-secondary-700 mb-1">
                  Phone: <a
                    href="tel:+919892200796"
