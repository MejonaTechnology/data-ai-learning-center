---
import PageLayout from "../components/PageLayout.astro";

// Helper function for proper URLs
const baseUrl = import.meta.env.BASE_URL || "/";
const createUrl = (path: string) => {
  if (path === "/") return baseUrl;
  const normalizedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  return normalizedBase + path;
};
---

<PageLayout
  title="Terms of Service"
  description="CodeStreet's Terms of Service - Read the terms and conditions governing your use of our educational platform and services."
  pageTitle="Terms of Service"
  pageSubtitle="Please read these terms carefully as they govern your use of our educational services."
