---
import PageLayout from '../components/PageLayout.astro';

// Helper function for proper URLs
const baseUrl = import.meta.env.BASE_URL || '/';
const createUrl = (path: string) => {
  if (path === '/') return baseUrl;
  // Ensure baseUrl ends with slash before adding path
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  return normalizedBase + path;
};
---

<PageLayout 
  title="Contact Us" 
  description="Get in touch with CodeStreet - Bridging Talent with Opportunity. We're here to help you start your journey in data science and artificial intelligence."
  pageTitle="Contact Us"
  pageSubtitle="Have questions about our programs? We're here to help guide your learning journey."
>

    <!-- Contact Content -->
    <section class="section-padding bg-secondary-50">
      <div class="section-container">
        <div class="wide-container">
          <div class="grid lg:grid-cols-2 gap-16">
            
            <!-- Contact Information -->
            <div>
              <h2 class="text-3xl font-heading font-bold text-secondary-900 mb-8">
                Get In Touch
              </h2>
              
              <div class="space-y-8 mb-12">
                <!-- Email -->
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-secondary-900 mb-2">Email Us</h3>
                    <p class="text-secondary-700 mb-2">Send us a message and we'll respond within 24 hours.</p>
                    <a href="mailto:info@peakserves.com" class="text-primary-600 hover:text-primary-700 font-medium">
                      info@peakserves.com
                    </a>
                  </div>
                </div>

                <!-- Phone -->
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-secondary-900 mb-2">Call Us</h3>
                    <p class="text-secondary-700 mb-2">Speak directly with our education consultants.</p>
                    <a href="tel:+919892200796" class="text-primary-600 hover:text-primary-700 font-medium">
                      +91 98922 00796
                    </a>
                  </div>
                </div>

                <!-- Office Hours -->
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-secondary-900 mb-2">Office Hours</h3>
                    <div class="text-secondary-700 space-y-1">
                      <p>Monday - Friday: 9:00 AM - 7:00 PM IST</p>
                      <p>Saturday: 10:00 AM - 4:00 PM IST</p>
                      <p>Sunday: Closed</p>
                    </div>
                  </div>
                </div>

                <!-- Location -->
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-secondary-900 mb-2">Location</h3>
                    <p class="text-secondary-700">
                      TOWER - E, CORONA OPTUS SOCIETY<br>
                      SECTOR 37C, GURUGRAM, HARYANA - 122001
                    </p>
                  </div>
                </div>
              </div>

              <!-- Quick Links -->
              <div class="card-elevated bg-white border-secondary-200 p-6">
                <h3 class="text-lg font-semibold text-secondary-900 mb-4">Quick Actions</h3>
                <div class="space-y-3">
                  <a href={createUrl('/enroll')} class="flex items-center gap-3 text-primary-600 hover:text-primary-700 font-medium">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd" />
                    </svg>
                    Enroll in a Program
                  </a>
                  <a href={createUrl('/tracks')} class="flex items-center gap-3 text-primary-600 hover:text-primary-700 font-medium">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Browse Learning Tracks
                  </a>
                </div>
              </div>
            </div>

            <!-- Contact Form -->
            <div>
              <div class="card-elevated bg-white border-secondary-200 p-8">
                <h2 class="text-2xl font-heading font-bold text-secondary-900 mb-6">
                  Send us a Message
                </h2>
                
                <form id="contactForm" class="space-y-6" novalidate>
                  <!-- Name and Email -->
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="name" class="block text-sm font-semibold text-secondary-700 mb-2">
                        Full Name <span class="text-red-500">*</span>
                      </label>
                      <input 
                        type="text" 
                        id="name" 
                        name="name" 
                        required 
                        aria-describedby="name-error"
                        class="form-input"
                        placeholder="Your full name"
                      >
                      <div id="name-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                    </div>
                    
                    <div>
                      <label for="email" class="block text-sm font-semibold text-secondary-700 mb-2">
                        Email Address <span class="text-red-500">*</span>
                      </label>
                      <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        required 
                        aria-describedby="email-error"
                        class="form-input"
                        placeholder="your.email@example.com"
                      >
                      <div id="email-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                    </div>
                  </div>

                  <!-- Phone and Subject -->
                  <div class="grid md:grid-cols-2 gap-4">
                    <div>
                      <label for="phone" class="block text-sm font-semibold text-secondary-700 mb-2">
                        Phone Number
                      </label>
                      <input 
                        type="tel" 
                        id="phone" 
                        name="phone"
                        class="form-input"
                        placeholder="+91 98922 00796"
                      >
                    </div>
                    
                    <div>
                      <label for="subject" class="block text-sm font-semibold text-secondary-700 mb-2">
                        Subject <span class="text-red-500">*</span>
                      </label>
                      <select 
                        id="subject" 
                        name="subject" 
                        required 
                        aria-describedby="subject-error"
                        class="form-select"
                      >
                        <option value="">Select a topic</option>
                        <option value="enrollment">Program Enrollment</option>
                        <option value="curriculum">Curriculum Questions</option>
                        <option value="pricing">Pricing & Payment</option>
                        <option value="support">Technical Support</option>
                        <option value="career">Career Guidance</option>
                        <option value="other">Other</option>
                      </select>
                      <div id="subject-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                    </div>
                  </div>

                  <!-- Message -->
                  <div>
                    <label for="message" class="block text-sm font-semibold text-secondary-700 mb-2">
                      Message <span class="text-red-500">*</span>
                    </label>
                    <textarea 
                      id="message" 
                      name="message" 
                      rows="5" 
                      required 
                      aria-describedby="message-error"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors duration-200"
                      placeholder="Please share your questions or how we can help you..."
                    ></textarea>
                    <div id="message-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                  </div>

                  <!-- Submit Button -->
                  <div class="text-center pt-4">
                    <button 
                      type="submit" 
                      class="btn-primary text-lg px-8 py-3 disabled:opacity-50 disabled:cursor-not-allowed"
                      id="submitBtn"
                    >
                      Send Message
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Message Modal -->
    <div id="successMessage" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
      <div class="bg-white p-8 rounded-xl max-w-md mx-4">
        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-neutral-900 mb-2">Message Sent!</h3>
          <p class="text-neutral-600 mb-6">
            Thank you for contacting us. We'll get back to you within 24 hours.
          </p>
          <button onclick="closeSuccessMessage()" class="btn-primary">
            Close
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Contact form validation and submission
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');
    
    // Form validation function
    function validateField(field) {
      const value = field.value.trim();
      const errorElement = document.getElementById(field.name + '-error');
      let isValid = true;
      let errorMessage = '';

      // Remove existing error styling
      field.classList.remove('border-red-500');
      if (errorElement) {
        errorElement.classList.add('hidden');
        errorElement.textContent = '';
      }

      // Required field validation
      if (field.hasAttribute('required') && !value) {
        isValid = false;
        errorMessage = 'This field is required';
      }
      
      // Email validation
      else if (field.type === 'email' && value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) {
          isValid = false;
          errorMessage = 'Please enter a valid email address';
        }
      }
      
      // Phone validation (optional field)
      else if (field.type === 'tel' && value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(value.replace(/[\s\-\(\)]/g, ''))) {
          isValid = false;
          errorMessage = 'Please enter a valid phone number';
        }
      }

      // Message minimum length
      else if (field.name === 'message' && value && value.length < 10) {
        isValid = false;
        errorMessage = 'Please provide a message with at least 10 characters';
      }

      // Display error if invalid
      if (!isValid && errorElement) {
        field.classList.add('border-red-500');
        errorElement.textContent = errorMessage;
        errorElement.classList.remove('hidden');
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.setAttribute('aria-invalid', 'false');
      }

      return isValid;
    }

    // Real-time validation
    const fields = form.querySelectorAll('input, select, textarea');
    fields.forEach(field => {
      field.addEventListener('blur', () => validateField(field));
      field.addEventListener('input', () => {
        if (field.classList.contains('border-red-500')) {
          validateField(field);
        }
      });
    });

    // Form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Validate all required fields
      const requiredFields = form.querySelectorAll('[required]');
      let isFormValid = true;
      
      requiredFields.forEach(field => {
        if (!validateField(field)) {
          isFormValid = false;
        }
      });

      if (isFormValid) {
        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        // Submit to Google Forms
        submitContactToGoogleForm();
      } else {
        // Focus on first error field
        const firstError = form.querySelector('.border-red-500');
        if (firstError) {
          firstError.focus();
        }
      }
    });
  });

  // Submit to Google Forms
  function submitContactToGoogleForm() {
    const form = document.getElementById('contactForm');
    const formData = new FormData(form);
    
    // Google Forms endpoint - UPDATE THIS WITH YOUR ACTUAL GOOGLE FORM URL
    // Replace with your Google Form's formResponse URL when you create it
    const googleFormURL = 'https://docs.google.com/forms/d/e/YOUR_FORM_ID_HERE/formResponse';
    
    // Create form data for Google Forms submission
    const googleFormData = new FormData();
    
    // Map form fields to Google Form entry IDs
    // Replace these entry IDs with actual ones from your Google Form
    googleFormData.append('entry.123456789', formData.get('name') || ''); // Full Name
    googleFormData.append('entry.987654321', formData.get('email') || ''); // Email Address
    googleFormData.append('entry.456789123', formData.get('phone') || ''); // Phone Number
    googleFormData.append('entry.789123456', formData.get('subject') || ''); // Subject
    googleFormData.append('entry.321654987', formData.get('message') || ''); // Message
    
    // Submit to Google Forms using no-cors mode
    fetch(googleFormURL, {
      method: 'POST',
      mode: 'no-cors',
      body: googleFormData
    })
    .then(() => {
      // Show success message
      document.getElementById('successMessage').classList.remove('hidden');
      
      // Reset form
      form.reset();
      
      // Re-enable submit button
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitBtn').textContent = 'Send Message';
    })
    .catch((error) => {
      console.error('Error submitting contact form:', error);
      
      // Still show success message since no-cors doesn't allow us to check the actual response
      document.getElementById('successMessage').classList.remove('hidden');
      
      // Reset form
      form.reset();
      
      // Re-enable submit button
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitBtn').textContent = 'Send Message';
    });
  }

  // Close success message functions
  function closeSuccessMessage() {
    document.getElementById('successMessage').classList.add('hidden');
  }

  // Close on outside click
  document.getElementById('successMessage').addEventListener('click', function(e) {
    if (e.target === this) {
      closeSuccessMessage();
    }
  });
</script>
</PageLayout>