---
import PageLayout from '../components/PageLayout.astro';

// Helper function for proper URLs
const baseUrl = import.meta.env.BASE_URL || '/';
const createUrl = (path: string) => {
  if (path === '/') return baseUrl;
  // Ensure baseUrl ends with slash before adding path
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  return normalizedBase + path;
};
---

<PageLayout 
  title="About CodeStreet" 
  description="Learn about CodeStreet's mission to transform careers through comprehensive data science and AI education. Discover our approach to hands-on learning."
  pageTitle="About CodeStreet"
  pageSubtitle="Bridging Talent with Opportunity - empowering the next generation of data scientists and AI professionals through comprehensive, hands-on learning."
