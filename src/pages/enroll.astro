<script>
  // Form validation and submission
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('enrollmentForm');
    const submitBtn = document.getElementById('submitBtn');
    
    // Form validation
    function validateField(field) {
      const value = field.value.trim();
      const errorElement = document.getElementById(field.name + '-error');
      let isValid = true;
      let errorMessage = '';

      // Remove existing error styling
      field.classList.remove('border-red-500');
      errorElement.classList.add('hidden');
      errorElement.textContent = '';

      // Required field validation
      if (field.hasAttribute('required') && !value) {
        isValid = false;
        errorMessage = 'This field is required';
      }
      
      // Email validation
      else if (field.type === 'email' && value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) {
          isValid = false;
          errorMessage = 'Please enter a valid email address';
        }
      }
      
      // Phone validation
      else if (field.type === 'tel' && value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(value.replace(/[\s\-\(\)]/g, ''))) {
          isValid = false;
          errorMessage = 'Please enter a valid phone number';
        }
      }

      // Display error if invalid
      if (!isValid) {
        field.classList.add('border-red-500');
        errorElement.textContent = errorMessage;
        errorElement.classList.remove('hidden');
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.setAttribute('aria-invalid', 'false');
      }

      return isValid;
    }

    // Real-time validation
    const fields = form.querySelectorAll('input[required], select[required]');
    fields.forEach(field => {
      if (field.type !== 'radio') {
        field.addEventListener('blur', () => validateField(field));
        field.addEventListener('input', () => {
          if (field.classList.contains('border-red-500')) {
            validateField(field);
          }
        });
      }
    });

    // Special handling for checkbox groups and radio button groups
    const checkboxGroups = ['whyJoin', 'excitement'];
    const radioGroups = ['commitment', 'aptitudeTest', 'feeStructure'];
    
    // Handle checkbox groups
    checkboxGroups.forEach(groupName => {
      const checkboxes = form.querySelectorAll(`input[name="${groupName}"]`);
      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
          const errorElement = document.getElementById(groupName + '-error');
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
          
          // Handle "Other" option text area
          if (checkbox.value === 'Other') {
            const otherTextArea = document.getElementById(groupName + 'OtherText');
            if (otherTextArea) {
              if (checkbox.checked) {
                otherTextArea.classList.remove('hidden');
                otherTextArea.querySelector('textarea').focus();
              } else {
                otherTextArea.classList.add('hidden');
                otherTextArea.querySelector('textarea').value = '';
              }
            }
          }
        });
      });
    });
    
    // Handle radio button groups
    radioGroups.forEach(groupName => {
      const radioButtons = form.querySelectorAll(`input[name="${groupName}"]`);
      radioButtons.forEach(radio => {
        radio.addEventListener('change', () => {
          const errorElement = document.getElementById(groupName + '-error');
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        });
      });
    });


    // Form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Validate ALL required fields including text, select, and textarea
      let isFormValid = true;
      const requiredTextFields = ['fullName', 'email', 'mobile', 'college', 'degree', 'graduation', 'jobType', 'expectedCTC', 'questions'];
      
      // Validate all text/select/textarea fields
      requiredTextFields.forEach(fieldName => {
        const field = form.querySelector(`[name="${fieldName}"]`);
        if (field && !validateField(field)) {
          isFormValid = false;
        }
      });

      // Validate checkbox groups (at least one must be selected)
      const checkboxGroups = ['whyJoin', 'excitement'];
      checkboxGroups.forEach(groupName => {
        const checkedCheckboxes = form.querySelectorAll(`input[name="${groupName}"]:checked`);
        const errorElement = document.getElementById(groupName + '-error');
        if (checkedCheckboxes.length === 0) {
          isFormValid = false;
          if (errorElement) {
            errorElement.textContent = 'This field is required - please select at least one option';
            errorElement.classList.remove('hidden');
          }
        } else {
          // Check if "Other" is selected but text area is empty
          const otherCheckbox = form.querySelector(`input[name="${groupName}"][value="Other"]:checked`);
          if (otherCheckbox) {
            const otherTextArea = form.querySelector(`textarea[name="${groupName}OtherText"]`);
            if (otherTextArea && !otherTextArea.value.trim()) {
              isFormValid = false;
              if (errorElement) {
                errorElement.textContent = 'Please specify your "Other" selection';
                errorElement.classList.remove('hidden');
              }
            } else if (errorElement) {
              errorElement.classList.add('hidden');
            }
          } else if (errorElement) {
            errorElement.classList.add('hidden');
          }
        }
      });
      
      // Validate radio button groups
      const radioGroups = ['commitment', 'aptitudeTest', 'feeStructure'];
      radioGroups.forEach(groupName => {
        const checkedRadio = form.querySelector(`input[name="${groupName}"]:checked`);
        const errorElement = document.getElementById(groupName + '-error');
        if (!checkedRadio) {
          isFormValid = false;
          if (errorElement) {
            errorElement.textContent = 'This field is required - please select an option';
            errorElement.classList.remove('hidden');
          }
        } else {
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        }
      });

      // Check terms checkbox (required)
      const termsCheckbox = document.getElementById('terms');
      const termsError = document.getElementById('terms-error');
      if (!termsCheckbox.checked) {
        isFormValid = false;
        termsError.textContent = 'You must agree to the terms and conditions';
        termsError.classList.remove('hidden');
      } else {
        termsError.classList.add('hidden');
      }

      if (isFormValid) {
        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        // Submit to Web3Forms
        submitToWeb3Forms();
      } else {
        // Focus on first error field
        const firstError = form.querySelector('.border-red-500');
        if (firstError) {
          firstError.focus();
        } else {
          // If no field with border error, find first empty required field
          const firstEmptyField = form.querySelector('input[required]:invalid, select[required]:invalid, textarea[required]:invalid');
          if (firstEmptyField) {
            firstEmptyField.focus();
          }
        }
      }
    });
  });

