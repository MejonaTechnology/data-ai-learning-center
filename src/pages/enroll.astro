  </main>
</Layout>

<script>
  // Form validation and submission
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('enrollmentForm');
    const submitBtn = document.getElementById('submitBtn');
    
    // Form validation
    function validateField(field) {
      const value = field.value.trim();
      const errorElement = document.getElementById(field.name + '-error');
      let isValid = true;
      let errorMessage = '';

      // Remove existing error styling
      field.classList.remove('border-red-500');
      errorElement.classList.add('hidden');
      errorElement.textContent = '';

      // Required field validation
      if (field.hasAttribute('required') && !value) {
        isValid = false;
        errorMessage = 'This field is required';
      }
      
      // Email validation
      else if (field.type === 'email' && value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) {
          isValid = false;
          errorMessage = 'Please enter a valid email address';
        }
      }
      
      // Phone validation
      else if (field.type === 'tel' && value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(value.replace(/[\s\-\(\)]/g, ''))) {
          isValid = false;
          errorMessage = 'Please enter a valid phone number';
        }
      }

      // Display error if invalid
      if (!isValid) {
        field.classList.add('border-red-500');
        errorElement.textContent = errorMessage;
        errorElement.classList.remove('hidden');
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.setAttribute('aria-invalid', 'false');
      }

      return isValid;
    }

    // Real-time validation
    const fields = form.querySelectorAll('input[required], select[required]');
    fields.forEach(field => {
      if (field.type !== 'radio') {
        field.addEventListener('blur', () => validateField(field));
        field.addEventListener('input', () => {
          if (field.classList.contains('border-red-500')) {
            validateField(field);
          }
        });
      }
    });

    // Special handling for radio button groups
    const radioGroups = ['whyJoin', 'excitement', 'commitment', 'aptitudeTest', 'feeStructure'];
    radioGroups.forEach(groupName => {
      const radioButtons = form.querySelectorAll(`input[name="${groupName}"]`);
      radioButtons.forEach(radio => {
        radio.addEventListener('change', () => {
          const errorElement = document.getElementById(groupName + '-error');
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        });
      });
    });


    // Form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Validate all fields
      let isFormValid = true;
      fields.forEach(field => {
        if (field.type !== 'radio' && !validateField(field)) {
          isFormValid = false;
        }
      });


      // Validate radio button groups
      const radioGroups = ['whyJoin', 'excitement', 'commitment', 'aptitudeTest', 'feeStructure'];
      radioGroups.forEach(groupName => {
        const checkedRadio = form.querySelector(`input[name="${groupName}"]:checked`);
        const errorElement = document.getElementById(groupName + '-error');
        if (!checkedRadio) {
          isFormValid = false;
          if (errorElement) {
            errorElement.textContent = 'Please select an option';
            errorElement.classList.remove('hidden');
          }
        } else {
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        }
      });

      // Check terms checkbox
      const termsCheckbox = document.getElementById('terms');
      const termsError = document.getElementById('terms-error');
      if (!termsCheckbox.checked) {
        isFormValid = false;
        termsError.textContent = 'You must agree to the terms and conditions';
        termsError.classList.remove('hidden');
      } else {
        termsError.classList.add('hidden');
      }

      if (isFormValid) {
        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        // Submit to Google Forms
        submitToGoogleForm();
      } else {
        // Focus on first error field
        const firstError = form.querySelector('.border-red-500');
        if (firstError) {
          firstError.focus();
        }
      }
    });
  });

  // Submit to Google Forms
  function submitToGoogleForm() {
    const form = document.getElementById('enrollmentForm');
    const formData = new FormData(form);
    
    // Google Forms endpoint (from your URL: https://forms.gle/LfSctkcb5zEYVfFz6)
    const googleFormURL = 'https://docs.google.com/forms/d/e/1FAIpQLSezVPf-8lEEZoVcDonb4oUJhL-TeG9jydiq6zTvL3gfchPYHw/formResponse';
    
    // Create form data for Google Forms submission
    const googleFormData = new FormData();
    
    // Map form fields directly to Google Form entry IDs
    googleFormData.append('entry.474503873', formData.get('fullName') || ''); // Full Name
    googleFormData.append('entry.395122520', formData.get('email') || ''); // Email Address
    googleFormData.append('entry.490734768', formData.get('mobile') || ''); // Mobile Number
    googleFormData.append('entry.1870615356', formData.get('college') || ''); // College Name
    googleFormData.append('entry.624850530', formData.get('degree') || ''); // Degree & Branch
    googleFormData.append('entry.1176946467', formData.get('graduation') || ''); // Year of Graduation
    
    googleFormData.append('entry.1969104661', formData.get('whyJoin') || ''); // Why join program
    googleFormData.append('entry.1279825415', formData.get('jobType') || ''); // Job type aiming for
    googleFormData.append('entry.956741069', formData.get('expectedCTC') || ''); // Expected CTC
    googleFormData.append('entry.129557825', formData.get('excitement') || ''); // What excites you most
    googleFormData.append('entry.788782582', formData.get('commitment') || ''); // Willing to commit 6 months
    googleFormData.append('entry.711643485', formData.get('aptitudeTest') || ''); // Willing to appear for aptitude test
    googleFormData.append('entry.847211950', formData.get('feeStructure') || ''); // Understanding of Fee Structure
    googleFormData.append('entry.923650440', formData.get('questions') || ''); // Any questions
    
    // Submit to Google Forms using no-cors mode
    fetch(googleFormURL, {
      method: 'POST',
      mode: 'no-cors',
      body: googleFormData
    })
    .then(() => {
      // Show success message
      showSuccessMessage();
      
      // Reset form
      form.reset();
      
      
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitBtn').textContent = 'Enroll Now';
    })
    .catch((error) => {
      console.error('Error submitting form:', error);
      
      // Still show success message since no-cors doesn't allow us to check the actual response
      showSuccessMessage();
      
      // Reset form
      form.reset();
      
      
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitBtn').textContent = 'Enroll Now';
    });
  }

  // Show success message
  function showSuccessMessage() {
    const successModal = document.getElementById('successMessage');
    if (successModal) {
      successModal.classList.remove('hidden');
      // Focus on the modal for accessibility
      successModal.setAttribute('tabindex', '-1');
      successModal.focus();
    }
  }

  // Close success message
  function closeSuccessMessage() {
    const successModal = document.getElementById('successMessage');
    if (successModal) {
      successModal.classList.add('hidden');
    }
  }

  // Make closeSuccessMessage globally available
  window.closeSuccessMessage = closeSuccessMessage;

  // Close success message on outside click
  document.addEventListener('click', function(e) {
    const successModal = document.getElementById('successMessage');
    if (successModal && e.target === successModal) {
      closeSuccessMessage();
    }
  });

  // Close success message on escape key
  document.addEventListener('keydown', function(e) {
    const successModal = document.getElementById('successMessage');
    if (e.key === 'Escape' && successModal && !successModal.classList.contains('hidden')) {
      closeSuccessMessage();
    }
  });
</script>
</PageLayout>