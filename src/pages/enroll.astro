---
import PageLayout from '../components/PageLayout.astro';
import { getCollection } from 'astro:content';

const tracks = await getCollection('tracks');
const sortedTracks = tracks.sort((a, b) => a.data.order - b.data.order);

// Helper function for proper URLs
const baseUrl = import.meta.env.BASE_URL || '/';
const createUrl = (path: string) => {
  if (path === '/') return baseUrl;
  // Ensure baseUrl ends with slash before adding path
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  return normalizedBase + path;
};
---

<PageLayout 
  title="Enroll Now" 
  description="Start your data science and AI journey at CodeStreet. Choose from 8 specialized learning tracks and transform your career today."
  pageTitle="Enroll Now"
  pageSubtitle="Take the first step towards transforming your career in data science and AI"
>

    <!-- Enrollment Form -->
    <section class="section-padding bg-secondary-50">
      <div class="section-container">
        <div class="content-container">
          <div class="card-elevated bg-white border-secondary-200 p-8 lg:p-12">
            <h2 class="text-2xl lg:text-3xl font-heading font-bold text-secondary-900 mb-8 text-center">
              Start Your Learning Journey
            </h2>
            
            <form id="enrollmentForm" class="space-y-8" novalidate>
              <!-- Personal Information -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="firstName" class="block text-sm font-semibold text-secondary-700 mb-2">
                    First Name <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="firstName" 
                    name="firstName" 
                    required 
                    aria-describedby="firstName-error"
                    class="form-input"
                    placeholder="Enter your first name"
                  >
                  <div id="firstName-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
                
                <div>
                  <label for="lastName" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Last Name <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="lastName" 
                    name="lastName" 
                    required 
                    aria-describedby="lastName-error"
                    class="form-input"
                    placeholder="Enter your last name"
                  >
                  <div id="lastName-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
              </div>

              <!-- Contact Information -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="email" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    aria-describedby="email-error"
                    class="form-input"
                    placeholder="your.email@example.com"
                  >
                  <div id="email-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
                
                <div>
                  <label for="phone" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Phone Number <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    required 
                    aria-describedby="phone-error"
                    class="form-input"
                    placeholder="+1 (555) 123-4567"
                  >
                  <div id="phone-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
              </div>

              <!-- Track Selection -->
              <div>
                <label for="selectedTrack" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Choose Your Learning Track <span class="text-red-500">*</span>
                </label>
                <select 
                  id="selectedTrack" 
                  name="selectedTrack" 
                  required 
                  aria-describedby="selectedTrack-error"
                  class="form-select"
                >
                  <option value="">Select a learning track</option>
                  <optgroup label="Foundation Tracks (2 Months)">
                    {sortedTracks
                      .filter(track => track.data.level === 'foundation')
                      .map(track => (
                        <option value={track.slug}>{track.data.title}</option>
                      ))
                    }
                  </optgroup>
                  <optgroup label="Specialization Tracks (3 Months)">
                    {sortedTracks
                      .filter(track => track.data.level === 'specialization')
                      .map(track => (
                        <option value={track.slug}>{track.data.title}</option>
                      ))
                    }
                  </optgroup>
                  <optgroup label="Advanced Tracks (3 Months)">
                    {sortedTracks
                      .filter(track => track.data.level === 'advanced')
                      .map(track => (
                        <option value={track.slug}>{track.data.title}</option>
                      ))
                    }
                  </optgroup>
                </select>
                <div id="selectedTrack-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Background Information -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="experience" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Experience Level
                  </label>
                  <select 
                    id="experience" 
                    name="experience"
                    class="form-select"
                  >
                    <option value="beginner">Complete Beginner</option>
                    <option value="some">Some Experience</option>
                    <option value="intermediate">Intermediate</option>
                    <option value="advanced">Advanced</option>
                  </select>
                </div>
                
                <div>
                  <label for="currentRole" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Current Role/Field
                  </label>
                  <input 
                    type="text" 
                    id="currentRole" 
                    name="currentRole"
                    class="form-input"
                    placeholder="e.g., Software Developer, Student, etc."
                  >
                </div>
              </div>

              <!-- Goals and Motivation -->
              <div>
                <label for="goals" class="block text-sm font-semibold text-secondary-700 mb-2">
                  What are your learning goals? <span class="text-secondary-500">(Optional)</span>
                </label>
                <textarea 
                  id="goals" 
                  name="goals" 
                  rows="4"
                  class="form-select"
                  placeholder="Tell us about your career goals and what you hope to achieve with this training..."
                ></textarea>
              </div>

              <!-- Terms and Conditions -->
              <div class="flex items-start gap-3">
                <input 
                  type="checkbox" 
                  id="terms" 
                  name="terms" 
                  required 
                  aria-describedby="terms-error"
                  class="mt-1 w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500"
                >
                <label for="terms" class="text-sm text-secondary-700">
                  I agree to the <a href={createUrl('/terms')} class="text-primary-600 hover:text-primary-700 underline">Terms of Service</a> 
                  and <a href={createUrl('/privacy')} class="text-primary-600 hover:text-primary-700 underline">Privacy Policy</a> 
                  <span class="text-red-500">*</span>
                </label>
              </div>
              <div id="terms-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>

              <!-- Submit Button -->
              <div class="text-center pt-4">
                <button 
                  type="submit" 
                  class="btn-primary text-lg px-12 py-4 disabled:opacity-50 disabled:cursor-not-allowed"
                  id="submitBtn"
                >
                  Enroll Now
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Message -->
    <div id="successMessage" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
      <div class="bg-white p-8 rounded-xl max-w-md mx-4">
        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-neutral-900 mb-2">Enrollment Submitted!</h3>
          <p class="text-neutral-600 mb-6">
            Thank you for your interest in CodeStreet. We'll contact you within 24 hours to complete your enrollment.
          </p>
          <button onclick="closeSuccessMessage()" class="btn-primary">
            Close
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Form validation and submission
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('enrollmentForm');
    const submitBtn = document.getElementById('submitBtn');
    
    // Form validation
    function validateField(field) {
      const value = field.value.trim();
      const errorElement = document.getElementById(field.name + '-error');
      let isValid = true;
      let errorMessage = '';

      // Remove existing error styling
      field.classList.remove('border-red-500');
      errorElement.classList.add('hidden');
      errorElement.textContent = '';

      // Required field validation
      if (field.hasAttribute('required') && !value) {
        isValid = false;
        errorMessage = 'This field is required';
      }
      
      // Email validation
      else if (field.type === 'email' && value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) {
          isValid = false;
          errorMessage = 'Please enter a valid email address';
        }
      }
      
      // Phone validation
      else if (field.type === 'tel' && value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(value.replace(/[\s\-\(\)]/g, ''))) {
          isValid = false;
          errorMessage = 'Please enter a valid phone number';
        }
      }

      // Display error if invalid
      if (!isValid) {
        field.classList.add('border-red-500');
        errorElement.textContent = errorMessage;
        errorElement.classList.remove('hidden');
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.setAttribute('aria-invalid', 'false');
      }

      return isValid;
    }

    // Real-time validation
    const fields = form.querySelectorAll('input[required], select[required]');
    fields.forEach(field => {
      field.addEventListener('blur', () => validateField(field));
      field.addEventListener('input', () => {
        if (field.classList.contains('border-red-500')) {
          validateField(field);
        }
      });
    });

    // Form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Validate all fields
      let isFormValid = true;
      fields.forEach(field => {
        if (!validateField(field)) {
          isFormValid = false;
        }
      });

      // Check terms checkbox
      const termsCheckbox = document.getElementById('terms');
      const termsError = document.getElementById('terms-error');
      if (!termsCheckbox.checked) {
        isFormValid = false;
        termsError.textContent = 'You must agree to the terms and conditions';
        termsError.classList.remove('hidden');
      } else {
        termsError.classList.add('hidden');
      }

      if (isFormValid) {
        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        // Simulate form submission (replace with actual API call)
        setTimeout(() => {
          // Show success message
          document.getElementById('successMessage').classList.remove('hidden');
          
          // Reset form
          form.reset();
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enroll Now';
        }, 1500);
      } else {
        // Focus on first error field
        const firstError = form.querySelector('.border-red-500');
        if (firstError) {
          firstError.focus();
        }
      }
    });
  });

  // Close success message
  function closeSuccessMessage() {
    document.getElementById('successMessage').classList.add('hidden');
  }

  // Close success message on outside click
  document.getElementById('successMessage').addEventListener('click', function(e) {
    if (e.target === this) {
      closeSuccessMessage();
    }
  });
</script>
</PageLayout>