---
import PageLayout from '../components/PageLayout.astro';
import { getCollection } from 'astro:content';

const tracks = await getCollection('tracks');
const sortedTracks = tracks.sort((a, b) => a.data.order - b.data.order);

// Helper function for proper URLs
const baseUrl = import.meta.env.BASE_URL || '/';
const createUrl = (path: string) => {
  if (path === '/') return baseUrl;
  // Ensure baseUrl ends with slash before adding path
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  return normalizedBase + path;
};
---

<PageLayout 
  title="Enroll Now" 
  description="Start your data science and AI journey at CodeStreet. Choose from 8 specialized learning tracks and transform your career today."
  pageTitle="Enroll Now"
  pageSubtitle="Take the first step towards transforming your career in data science and AI"
>

    <!-- Enrollment Form -->
    <section class="section-padding bg-secondary-50">
      <div class="section-container">
        <div class="content-container">
          <div class="card-elevated bg-white border-secondary-200 p-8 lg:p-12">
            <h2 class="text-2xl lg:text-3xl font-heading font-bold text-secondary-900 mb-8 text-center">
              Start Your Learning Journey
            </h2>
            
            <form id="enrollmentForm" class="space-y-8" novalidate>
              <!-- Personal Information -->
              <div>
                <label for="fullName" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="fullName" 
                  name="fullName" 
                  required 
                  aria-describedby="fullName-error"
                  class="form-input"
                  placeholder="Enter your full name"
                >
                <div id="fullName-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Contact Information -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="email" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    aria-describedby="email-error"
                    class="form-input"
                    placeholder="your.email@example.com"
                  >
                  <div id="email-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
                
                <div>
                  <label for="mobile" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Mobile Number <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="tel" 
                    id="mobile" 
                    name="mobile" 
                    required 
                    aria-describedby="mobile-error"
                    class="form-input"
                    placeholder="+91 98922 00796"
                  >
                  <div id="mobile-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
              </div>

              <!-- Education Information -->
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="college" class="block text-sm font-semibold text-secondary-700 mb-2">
                    College Name <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="college" 
                    name="college" 
                    required 
                    aria-describedby="college-error"
                    class="form-input"
                    placeholder="Enter your college name"
                  >
                  <div id="college-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
                
                <div>
                  <label for="degree" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Degree & Branch <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="degree" 
                    name="degree" 
                    required 
                    aria-describedby="degree-error"
                    class="form-input"
                    placeholder="e.g., B.Tech Computer Science"
                  >
                  <div id="degree-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
              </div>

              <!-- Year of Graduation -->
              <div>
                <label for="graduation" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Year of Graduation <span class="text-red-500">*</span>
                </label>
                <select 
                  id="graduation" 
                  name="graduation" 
                  required 
                  aria-describedby="graduation-error"
                  class="form-select"
                >
                  <option value="">Select year</option>
                  <option value="2024">2024</option>
                  <option value="2025">2025</option>
                  <option value="2026">2026</option>
                  <option value="2027">2027</option>
                  <option value="Already Graduated">Already Graduated</option>
                </select>
                <div id="graduation-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Program Interest -->
              <div>
                <label for="whyJoin" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Why do you want to join this program? <span class="text-red-500">*</span>
                </label>
                <div class="space-y-3" id="whyJoin" aria-describedby="whyJoin-error">
                  <label class="flex items-center">
                    <input type="radio" name="whyJoin" value="To gain real work experience" class="mr-3" required>
                    <span>To gain real work experience</span>
                  </label>
                  <label class="flex items-center">
                    <input type="radio" name="whyJoin" value="To improve my chances of getting a job" class="mr-3" required>
                    <span>To improve my chances of getting a job</span>
                  </label>
                  <label class="flex items-center">
                    <input type="radio" name="whyJoin" value="To earn while I learn" class="mr-3" required>
                    <span>To earn while I learn</span>
                  </label>
                  <label class="flex items-center">
                    <input type="radio" name="whyJoin" value="To build confidence & professional skills" class="mr-3" required>
                    <span>To build confidence & professional skills</span>
                  </label>
                </div>
                
                
                <div id="whyJoin-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Job Goals -->
              <div>
                <label for="jobType" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Job Type Aimed After Internship <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="jobType" 
                  name="jobType" 
                  required 
                  aria-describedby="jobType-error"
                  class="form-input"
                  placeholder="e.g., Data Scientist, AI Engineer, etc."
                >
                <div id="jobType-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Salary Expectations -->
              <div>
                <label for="expectedCTC" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Expected CTC <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  id="expectedCTC" 
                  name="expectedCTC" 
                  required 
                  aria-describedby="expectedCTC-error"
                  class="form-input"
                  placeholder="e.g., 5-8 LPA, 12+ LPA, etc."
                >
                <div id="expectedCTC-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Program Excitement -->
              <div>
                <label for="excitement" class="block text-sm font-semibold text-secondary-700 mb-2">
                  What Excites You Most <span class="text-red-500">*</span>
                </label>
                <div class="space-y-3" id="excitement" aria-describedby="excitement-error">
                  <label class="flex items-center">
                    <input type="radio" name="excitement" value="Guaranteed internship with stipend" class="mr-3" required>
                    <span>Guaranteed internship with stipend</span>
                  </label>
                  <label class="flex items-center">
                    <input type="radio" name="excitement" value="Placement support after internship" class="mr-3" required>
                    <span>Placement support after internship</span>
                  </label>
                  <label class="flex items-center">
                    <input type="radio" name="excitement" value="Training by industry experts" class="mr-3" required>
                    <span>Training by industry experts</span>
                  </label>
                  <label class="flex items-center">
                    <input type="radio" name="excitement" value="Real corporate exposure" class="mr-3" required>
                    <span>Real corporate exposure</span>
                  </label>
                  <label class="flex items-center">
                    <input type="radio" name="excitement" value="Internship certificate to strengthen CV" class="mr-3" required>
                    <span>Internship certificate to strengthen CV</span>
                  </label>
                </div>
                <div id="excitement-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Commitment Questions -->
              <div class="space-y-6">
                <div>
                  <label for="commitment" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Willing to Commit 6 Months <span class="text-red-500">*</span>
                  </label>
                  <div class="space-y-2" id="commitment" aria-describedby="commitment-error">
                    <label class="flex items-center">
                      <input type="radio" name="commitment" value="Yes" class="mr-3" required>
                      <span>Yes</span>
                    </label>
                    <label class="flex items-center">
                      <input type="radio" name="commitment" value="No" class="mr-3" required>
                      <span>No</span>
                    </label>
                  </div>
                  <div id="commitment-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>

                <div>
                  <label for="aptitudeTest" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Willing to Take Aptitude Test <span class="text-red-500">*</span>
                  </label>
                  <div class="space-y-2" id="aptitudeTest" aria-describedby="aptitudeTest-error">
                    <label class="flex items-center">
                      <input type="radio" name="aptitudeTest" value="Yes" class="mr-3" required>
                      <span>Yes</span>
                    </label>
                    <label class="flex items-center">
                      <input type="radio" name="aptitudeTest" value="No" class="mr-3" required>
                      <span>No</span>
                    </label>
                  </div>
                  <div id="aptitudeTest-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>

                <div>
                  <label for="feeStructure" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Understanding Fee Structure <span class="text-red-500">*</span>
                  </label>
                  <div class="space-y-2" id="feeStructure" aria-describedby="feeStructure-error">
                    <label class="flex items-center">
                      <input type="radio" name="feeStructure" value="Yes, I understand & agree" class="mr-3" required>
                      <span>Yes, I understand & agree</span>
                    </label>
                    <label class="flex items-center">
                      <input type="radio" name="feeStructure" value="No, I have doubts and want clarity" class="mr-3" required>
                      <span>No, I have doubts and want clarity</span>
                    </label>
                  </div>
                  <div id="feeStructure-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
              </div>

              <!-- Additional Questions -->
              <div>
                <label for="questions" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Any questions you want to ask us? <span class="text-red-500">*</span>
                </label>
                <textarea 
                  id="questions" 
                  name="questions" 
                  rows="4"
                  required
                  aria-describedby="questions-error"
                  class="form-textarea"
                  placeholder="Feel free to ask any questions about the program, curriculum, or anything else..."
                ></textarea>
                <div id="questions-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Terms and Conditions -->
              <div class="flex items-start gap-3">
                <input 
                  type="checkbox" 
                  id="terms" 
                  name="terms" 
                  required 
                  aria-describedby="terms-error"
                  class="mt-1 w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500"
                >
                <label for="terms" class="text-sm text-secondary-700">
                  I agree to the <a href={createUrl('/terms')} class="text-primary-600 hover:text-primary-700 underline">Terms of Service</a> 
                  and <a href={createUrl('/privacy')} class="text-primary-600 hover:text-primary-700 underline">Privacy Policy</a> 
                  <span class="text-red-500">*</span>
                </label>
              </div>
              <div id="terms-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>

              <!-- Submit Button -->
              <div class="text-center pt-4">
                <button 
                  type="submit" 
                  class="btn-primary text-lg px-12 py-4 disabled:opacity-50 disabled:cursor-not-allowed"
                  id="submitBtn"
                >
                  Enroll Now
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Message -->
    <div id="successMessage" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
      <div class="bg-white p-8 rounded-xl max-w-md mx-4">
        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-neutral-900 mb-2">Enrollment Submitted!</h3>
          <p class="text-neutral-600 mb-6">
            Thank you for your interest in CodeStreet. We'll contact you within 24 hours to complete your enrollment.
          </p>
          <button onclick="closeSuccessMessage()" class="btn-primary">
            Close
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Form validation and submission
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('enrollmentForm');
    const submitBtn = document.getElementById('submitBtn');
    
    // Form validation
    function validateField(field) {
      const value = field.value.trim();
      const errorElement = document.getElementById(field.name + '-error');
      let isValid = true;
      let errorMessage = '';

      // Remove existing error styling
      field.classList.remove('border-red-500');
      errorElement.classList.add('hidden');
      errorElement.textContent = '';

      // Required field validation
      if (field.hasAttribute('required') && !value) {
        isValid = false;
        errorMessage = 'This field is required';
      }
      
      // Email validation
      else if (field.type === 'email' && value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) {
          isValid = false;
          errorMessage = 'Please enter a valid email address';
        }
      }
      
      // Phone validation
      else if (field.type === 'tel' && value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(value.replace(/[\s\-\(\)]/g, ''))) {
          isValid = false;
          errorMessage = 'Please enter a valid phone number';
        }
      }

      // Display error if invalid
      if (!isValid) {
        field.classList.add('border-red-500');
        errorElement.textContent = errorMessage;
        errorElement.classList.remove('hidden');
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.setAttribute('aria-invalid', 'false');
      }

      return isValid;
    }

    // Real-time validation
    const fields = form.querySelectorAll('input[required], select[required]');
    fields.forEach(field => {
      if (field.type !== 'radio') {
        field.addEventListener('blur', () => validateField(field));
        field.addEventListener('input', () => {
          if (field.classList.contains('border-red-500')) {
            validateField(field);
          }
        });
      }
    });

    // Special handling for radio button groups
    const radioGroups = ['whyJoin', 'excitement', 'commitment', 'aptitudeTest', 'feeStructure'];
    radioGroups.forEach(groupName => {
      const radioButtons = form.querySelectorAll(`input[name="${groupName}"]`);
      radioButtons.forEach(radio => {
        radio.addEventListener('change', () => {
          const errorElement = document.getElementById(groupName + '-error');
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        });
      });
    });


    // Form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Validate all fields
      let isFormValid = true;
      fields.forEach(field => {
        if (field.type !== 'radio' && !validateField(field)) {
          isFormValid = false;
        }
      });


      // Validate radio button groups
      const radioGroups = ['whyJoin', 'excitement', 'commitment', 'aptitudeTest', 'feeStructure'];
      radioGroups.forEach(groupName => {
        const checkedRadio = form.querySelector(`input[name="${groupName}"]:checked`);
        const errorElement = document.getElementById(groupName + '-error');
        if (!checkedRadio) {
          isFormValid = false;
          if (errorElement) {
            errorElement.textContent = 'Please select an option';
            errorElement.classList.remove('hidden');
          }
        } else {
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        }
      });

      // Check terms checkbox
      const termsCheckbox = document.getElementById('terms');
      const termsError = document.getElementById('terms-error');
      if (!termsCheckbox.checked) {
        isFormValid = false;
        termsError.textContent = 'You must agree to the terms and conditions';
        termsError.classList.remove('hidden');
      } else {
        termsError.classList.add('hidden');
      }

      if (isFormValid) {
        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        // Submit to Google Forms
        submitToGoogleForm();
      } else {
        // Focus on first error field
        const firstError = form.querySelector('.border-red-500');
        if (firstError) {
          firstError.focus();
        }
      }
    });
  });

  // Submit to Google Forms
  function submitToGoogleForm() {
    const form = document.getElementById('enrollmentForm');
    const formData = new FormData(form);
    
    // Google Forms endpoint (from your URL: https://forms.gle/LfSctkcb5zEYVfFz6)
    const googleFormURL = 'https://docs.google.com/forms/d/e/1FAIpQLSezVPf-8lEEZoVcDonb4oUJhL-TeG9jydiq6zTvL3gfchPYHw/formResponse';
    
    // Create form data for Google Forms submission
    const googleFormData = new FormData();
    
    // Map form fields directly to Google Form entry IDs
    googleFormData.append('entry.474503873', formData.get('fullName') || ''); // Full Name
    googleFormData.append('entry.395122520', formData.get('email') || ''); // Email Address
    googleFormData.append('entry.490734768', formData.get('mobile') || ''); // Mobile Number
    googleFormData.append('entry.1870615356', formData.get('college') || ''); // College Name
    googleFormData.append('entry.624850530', formData.get('degree') || ''); // Degree & Branch
    googleFormData.append('entry.1176946467', formData.get('graduation') || ''); // Year of Graduation
    
    googleFormData.append('entry.1969104661', formData.get('whyJoin') || ''); // Why join program
    googleFormData.append('entry.1279825415', formData.get('jobType') || ''); // Job type aiming for
    googleFormData.append('entry.956741069', formData.get('expectedCTC') || ''); // Expected CTC
    googleFormData.append('entry.129557825', formData.get('excitement') || ''); // What excites you most
    googleFormData.append('entry.788782582', formData.get('commitment') || ''); // Willing to commit 6 months
    googleFormData.append('entry.711643485', formData.get('aptitudeTest') || ''); // Willing to appear for aptitude test
    googleFormData.append('entry.847211950', formData.get('feeStructure') || ''); // Understanding of Fee Structure
    googleFormData.append('entry.923650440', formData.get('questions') || ''); // Any questions
    
    // Submit to Google Forms using no-cors mode
    fetch(googleFormURL, {
      method: 'POST',
      mode: 'no-cors',
      body: googleFormData
    })
    .then(() => {
      // Show success message
      showSuccessMessage();
      
      // Reset form
      form.reset();
      
      
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitBtn').textContent = 'Enroll Now';
    })
    .catch((error) => {
      console.error('Error submitting form:', error);
      
      // Still show success message since no-cors doesn't allow us to check the actual response
      showSuccessMessage();
      
      // Reset form
      form.reset();
      
      
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitBtn').textContent = 'Enroll Now';
    });
  }

  // Show success message
  function showSuccessMessage() {
    const successModal = document.getElementById('successMessage');
    if (successModal) {
      successModal.classList.remove('hidden');
      // Focus on the modal for accessibility
      successModal.setAttribute('tabindex', '-1');
      successModal.focus();
    }
  }

  // Close success message
  function closeSuccessMessage() {
    const successModal = document.getElementById('successMessage');
    if (successModal) {
      successModal.classList.add('hidden');
    }
  }

  // Make closeSuccessMessage globally available
  window.closeSuccessMessage = closeSuccessMessage;

  // Close success message on outside click
  document.addEventListener('click', function(e) {
    const successModal = document.getElementById('successMessage');
    if (successModal && e.target === successModal) {
      closeSuccessMessage();
    }
  });

  // Close success message on escape key
  document.addEventListener('keydown', function(e) {
    const successModal = document.getElementById('successMessage');
    if (e.key === 'Escape' && successModal && !successModal.classList.contains('hidden')) {
      closeSuccessMessage();
    }
  });
</script>
</PageLayout>