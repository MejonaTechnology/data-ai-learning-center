        graduation_year: formData.get('graduation'),
        target_role: formData.get('jobType'),
        expected_ctc: formData.get('expectedCTC'),
        join_reason: Array.from(formData.getAll('whyJoin')).join(', ') + (formData.get('whyJoinOtherText') ? ` (Other: ${formData.get('whyJoinOtherText')})` : ''),
        excitement_factor: Array.from(formData.getAll('excitement')).join(', ') + (formData.get('excitementOtherText') ? ` (Other: ${formData.get('excitementOtherText')})` : ''),
        commitment_6months: formData.get('commitment'),
        aptitude_test_ready: formData.get('aptitudeTest'),
        fee_structure_agreed: formData.get('feeStructure'),
        additional_questions: formData.get('questions') || 'None',
        terms_accepted: formData.get('terms') ? 'Yes' : 'No',
        
        // Advanced Web3Forms options
        _template: 'table',
        _subject: `🎓 New Enrollment: ${formData.get('fullName')} - ${formData.get('jobType')} Track`,
        _captcha: false
      };
      
      // Submit to Web3Forms
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(formObject)
      });
      
      const data = await response.json();
      
      if (response.ok && data.success) {
        showSuccessModal();
        form.reset();
      } else {
        console.error('Web3Forms submission failed:', data);
        showErrorModal('There was an error submitting the form: ' + (data.message || 'Please try again.'));
      }
    } catch (error) {
      console.error('Error submitting form to Web3Forms:', error);
      showErrorModal('There was an error submitting the form. Please try again or contact us directly.');
    }
    
    // Re-enable submit button
    document.getElementById('submitBtn').disabled = false;
    document.getElementById('submitBtn').textContent = 'Submit Application';
  }


  // Show success message (legacy function for compatibility)
  function showSuccessMessage() {
    showSuccessModal();
  }

  // Close success message (legacy function for compatibility)
  function closeSuccessMessage() {
    closeSuccessModal();
  }

  // Make functions globally available
  window.closeSuccessMessage = closeSuccessMessage;
  window.closeSuccessModal = closeSuccessModal;
  window.closeErrorModal = closeErrorModal;

  // Modal animation helpers
  function showModalWithAnimation(modalId) {
    const modal = document.getElementById(modalId);
    const content = document.getElementById(modalId + 'Content');
    if (modal && content) {
      modal.classList.remove('hidden');
      setTimeout(() => {
        content.classList.remove('scale-95', 'opacity-0');
        content.classList.add('scale-100', 'opacity-100');
      }, 10);
    }
  }

  function hideModalWithAnimation(modalId, callback) {
    const modal = document.getElementById(modalId);
    const content = document.getElementById(modalId + 'Content');
    if (modal && content) {
      content.classList.remove('scale-100', 'opacity-100');
      content.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        if (callback) callback();
      }, 300);
    }
  }

  // Update modal functions to use animations
  function showSuccessModal() {
    showModalWithAnimation('successModal');
  }

  function showErrorModal(message) {
    const messageEl = document.getElementById('errorMessage');
    if (messageEl) {
      messageEl.textContent = message;
    }
    showModalWithAnimation('errorModal');
  }

  function closeSuccessModal() {
    hideModalWithAnimation('successModal');
  }

  function closeErrorModal() {
    hideModalWithAnimation('errorModal');
  }

  // Close modals on outside click
  document.addEventListener('click', function(e) {
    const successModal = document.getElementById('successModal');
    const errorModal = document.getElementById('errorModal');
    const legacySuccessModal = document.getElementById('successMessage');
    
    if (successModal && e.target === successModal) {
      closeSuccessModal();
    }
    if (errorModal && e.target === errorModal) {
      closeErrorModal();
    }
    if (legacySuccessModal && e.target === legacySuccessModal) {
      closeSuccessMessage();
    }
  });

  // Close modals on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const successModal = document.getElementById('successModal');
      const errorModal = document.getElementById('errorModal');
      const legacySuccessModal = document.getElementById('successMessage');
      
      if (successModal && !successModal.classList.contains('hidden')) {
        closeSuccessModal();
      } else if (errorModal && !errorModal.classList.contains('hidden')) {
        closeErrorModal();
      } else if (legacySuccessModal && !legacySuccessModal.classList.contains('hidden')) {
        closeSuccessMessage();
      }
    }
  });
</script>
</PageLayout>