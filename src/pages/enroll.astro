                <div>
                  <label for="commitment" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Willing to Commit 6 Months <span class="text-red-500">*</span>
                  </label>
                  <div class="space-y-2" id="commitment" aria-describedby="commitment-error">
                    <label class="flex items-center">
                      <input type="radio" name="commitment" value="Yes" class="mr-3" required>
                      <span>Yes</span>
                    </label>
                    <label class="flex items-center">
                      <input type="radio" name="commitment" value="No" class="mr-3" required>
                      <span>No</span>
                    </label>
                  </div>
                  <div id="commitment-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>

                <div>
                  <label for="aptitudeTest" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Willing to Take Aptitude Test <span class="text-red-500">*</span>
                  </label>
                  <div class="space-y-2" id="aptitudeTest" aria-describedby="aptitudeTest-error">
                    <label class="flex items-center">
                      <input type="radio" name="aptitudeTest" value="Yes" class="mr-3" required>
                      <span>Yes</span>
                    </label>
                    <label class="flex items-center">
                      <input type="radio" name="aptitudeTest" value="No" class="mr-3" required>
                      <span>No</span>
                    </label>
                  </div>
                  <div id="aptitudeTest-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>

                <div>
                  <label for="feeStructure" class="block text-sm font-semibold text-secondary-700 mb-2">
                    Understanding Fee Structure <span class="text-red-500">*</span>
                  </label>
                  <div class="space-y-2" id="feeStructure" aria-describedby="feeStructure-error">
                    <label class="flex items-center">
                      <input type="radio" name="feeStructure" value="Yes, I understand & agree" class="mr-3" required>
                      <span>Yes, I understand & agree</span>
                    </label>
                    <label class="flex items-center">
                      <input type="radio" name="feeStructure" value="No, I have doubts and want clarity" class="mr-3" required>
                      <span>No, I have doubts and want clarity</span>
                    </label>
                  </div>
                  <div id="feeStructure-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
                </div>
              </div>

              <!-- Additional Questions -->
              <div>
                <label for="questions" class="block text-sm font-semibold text-secondary-700 mb-2">
                  Any questions you want to ask us? <span class="text-red-500">*</span>
                </label>
                <textarea 
                  id="questions" 
                  name="questions" 
                  rows="4"
                  required
                  aria-describedby="questions-error"
                  class="form-textarea"
                  placeholder="Feel free to ask any questions about the program, curriculum, or anything else..."
                ></textarea>
                <div id="questions-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>
              </div>

              <!-- Terms and Conditions -->
              <div class="flex items-start gap-3">
                <input 
                  type="checkbox" 
                  id="terms" 
                  name="terms" 
                  required 
                  aria-describedby="terms-error"
                  class="mt-1 w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500"
                >
                <label for="terms" class="text-sm text-secondary-700">
                  I agree to the <a href={createUrl('/terms')} class="text-primary-600 hover:text-primary-700 underline">Terms of Service</a> 
                  and <a href={createUrl('/privacy')} class="text-primary-600 hover:text-primary-700 underline">Privacy Policy</a> 
                  <span class="text-red-500">*</span>
                </label>
              </div>
              <div id="terms-error" class="text-red-500 text-sm mt-1 hidden" role="alert"></div>

              <!-- Submit Button -->
              <div class="text-center pt-6 sm:pt-8">
                <button 
                  type="submit" 
                  class="w-full sm:w-auto btn-primary text-lg sm:text-xl px-8 sm:px-12 lg:px-16 py-4 sm:py-5 disabled:opacity-50 disabled:cursor-not-allowed shadow-2xl hover:shadow-3xl transform hover:scale-105 transition-all duration-300"
                  id="submitBtn"
                >
                  <span class="flex items-center justify-center gap-3">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                    Submit Application
                  </span>
                </button>
                <p class="text-xs sm:text-sm text-secondary-500 mt-3 sm:mt-4">
                  By submitting this form, you agree to our terms and conditions
                </p>
              </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Message -->
    <div id="successMessage" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
      <div class="bg-white p-8 rounded-xl max-w-md mx-4">
        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-neutral-900 mb-2">Enrollment Submitted!</h3>
          <p class="text-neutral-600 mb-6">
            Thank you for your interest in CodeStreet. We'll contact you within 24 hours to complete your enrollment.
          </p>
          <button onclick="closeSuccessMessage()" class="btn-primary">
            Close
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Form validation and submission
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('enrollmentForm');
    const submitBtn = document.getElementById('submitBtn');
    
    // Form validation
    function validateField(field) {
      const value = field.value.trim();
      const errorElement = document.getElementById(field.name + '-error');
      let isValid = true;
      let errorMessage = '';

      // Remove existing error styling
      field.classList.remove('border-red-500');
      errorElement.classList.add('hidden');
      errorElement.textContent = '';

      // Required field validation
      if (field.hasAttribute('required') && !value) {
        isValid = false;
        errorMessage = 'This field is required';
      }
      
      // Email validation
      else if (field.type === 'email' && value) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(value)) {
          isValid = false;
          errorMessage = 'Please enter a valid email address';
        }
      }
      
      // Phone validation
      else if (field.type === 'tel' && value) {
        const phoneRegex = /^[\+]?[1-9][\d]{0,15}$/;
        if (!phoneRegex.test(value.replace(/[\s\-\(\)]/g, ''))) {
          isValid = false;
          errorMessage = 'Please enter a valid phone number';
        }
      }

      // Display error if invalid
      if (!isValid) {
        field.classList.add('border-red-500');
        errorElement.textContent = errorMessage;
        errorElement.classList.remove('hidden');
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.setAttribute('aria-invalid', 'false');
      }

      return isValid;
    }

    // Real-time validation
    const fields = form.querySelectorAll('input[required], select[required]');
    fields.forEach(field => {
      if (field.type !== 'radio') {
        field.addEventListener('blur', () => validateField(field));
        field.addEventListener('input', () => {
          if (field.classList.contains('border-red-500')) {
            validateField(field);
          }
        });
      }
    });

    // Special handling for radio button groups
    const radioGroups = ['whyJoin', 'excitement', 'commitment', 'aptitudeTest', 'feeStructure'];
    radioGroups.forEach(groupName => {
      const radioButtons = form.querySelectorAll(`input[name="${groupName}"]`);
      radioButtons.forEach(radio => {
        radio.addEventListener('change', () => {
          const errorElement = document.getElementById(groupName + '-error');
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        });
      });
    });


    // Form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Validate ALL required fields including text, select, and textarea
      let isFormValid = true;
      const requiredTextFields = ['fullName', 'email', 'mobile', 'college', 'degree', 'graduation', 'jobType', 'expectedCTC', 'questions'];
      
      // Validate all text/select/textarea fields
      requiredTextFields.forEach(fieldName => {
        const field = form.querySelector(`[name="${fieldName}"]`);
        if (field && !validateField(field)) {
          isFormValid = false;
        }
      });

      // Validate ALL radio button groups (ALL are required)
      const radioGroups = ['whyJoin', 'excitement', 'commitment', 'aptitudeTest', 'feeStructure'];
      radioGroups.forEach(groupName => {
        const checkedRadio = form.querySelector(`input[name="${groupName}"]:checked`);
        const errorElement = document.getElementById(groupName + '-error');
        if (!checkedRadio) {
          isFormValid = false;
          if (errorElement) {
            errorElement.textContent = 'This field is required - please select an option';
            errorElement.classList.remove('hidden');
          }
        } else {
          if (errorElement) {
            errorElement.classList.add('hidden');
          }
        }
      });

      // Check terms checkbox (required)
      const termsCheckbox = document.getElementById('terms');
      const termsError = document.getElementById('terms-error');
      if (!termsCheckbox.checked) {
        isFormValid = false;
        termsError.textContent = 'You must agree to the terms and conditions';
        termsError.classList.remove('hidden');
      } else {
        termsError.classList.add('hidden');
      }

      if (isFormValid) {
        // Disable submit button
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        // Submit to Google Forms
        submitToGoogleForm();
      } else {
        // Focus on first error field
        const firstError = form.querySelector('.border-red-500');
        if (firstError) {
          firstError.focus();
        } else {
          // If no field with border error, find first empty required field
          const firstEmptyField = form.querySelector('input[required]:invalid, select[required]:invalid, textarea[required]:invalid');
          if (firstEmptyField) {
            firstEmptyField.focus();
          }
        }
      }
    });
  });

  // Submit to Google Forms
  function submitToGoogleForm() {
    const form = document.getElementById('enrollmentForm');
    const formData = new FormData(form);
    
    // Google Forms endpoint - exact URL from the form HTML
    const googleFormURL = 'https://docs.google.com/forms/u/0/d/e/1FAIpQLSezVPf-8lEEZoVcDonb4oUJhL-TeG9jydiq6zTvL3gfchPYHw/formResponse';
    
    // Create form data for Google Forms submission
    const googleFormData = new FormData();
    
    // Validate and map text input fields (ensure no empty values)
    const textFields = {
      'entry.474503873': formData.get('fullName')?.trim(), // Full Name
      'entry.395122520': formData.get('email')?.trim(), // Email Address
      'entry.490734768': formData.get('mobile')?.trim(), // Mobile Number
      'entry.1870615356': formData.get('college')?.trim(), // College Name
      'entry.624850530': formData.get('degree')?.trim(), // Degree & Branch
      'entry.1176946467': formData.get('graduation')?.trim(), // Year of Graduation
      'entry.1279825415': formData.get('jobType')?.trim(), // Job type aiming for
      'entry.956741069': formData.get('expectedCTC')?.trim(), // Expected CTC
      'entry.923650440': formData.get('questions')?.trim() // Any questions
    };
    
    // Map radio button fields to their correct entry IDs
    const radioFields = {
      'entry.894158014': formData.get('whyJoin'), // Why join program
      'entry.1718581503': formData.get('excitement'), // What excites you most
      'entry.634248384': formData.get('commitment'), // Willing to commit 6 months
      'entry.516485442': formData.get('aptitudeTest'), // Willing to appear for aptitude test
      'entry.1889721110': formData.get('feeStructure') // Understanding of Fee Structure
    };
    
    // Check for empty required fields before submission
    let hasEmptyFields = false;
    const emptyFields = [];
    
    Object.entries(textFields).forEach(([entryId, value]) => {
      if (!value || value.length === 0) {
        hasEmptyFields = true;
        emptyFields.push(entryId);
      } else {
        googleFormData.append(entryId, value);
      }
    });
    
    Object.entries(radioFields).forEach(([entryId, value]) => {
      if (!value || value.length === 0) {
        hasEmptyFields = true;
        emptyFields.push(entryId);
      } else {
        googleFormData.append(entryId, value);
      }
    });
    
    if (hasEmptyFields) {
      console.error('Empty required fields detected:', emptyFields);
      alert('Please fill in all required fields before submitting.');
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('submitBtn').textContent = 'Submit Application';
      return;
    }
    
    // Add required sentinel fields for radio button groups (from Google Form HTML)
    googleFormData.append('entry.894158014_sentinel', '');
    googleFormData.append('entry.1718581503_sentinel', '');
    googleFormData.append('entry.634248384_sentinel', '');
    googleFormData.append('entry.516485442_sentinel', '');
    googleFormData.append('entry.1889721110_sentinel', '');
    
    // Add required hidden fields
    googleFormData.append('fvv', '1');
    googleFormData.append('partialResponse', '[null,null,"' + Date.now() + '"]');
    googleFormData.append('pageHistory', '0');
    googleFormData.append('fbzx', Math.floor(Math.random() * 1000000000000000).toString());
    googleFormData.append('submissionTimestamp', Date.now().toString());
    
    // Log all form data for debugging
    console.log('=== FORM SUBMISSION DEBUG ===');
    console.log('Raw form data from form:');
    for (let [key, value] of formData.entries()) {
      console.log(`${key}: "${value}"`);
    }
    console.log('\nGoogle Form data being sent:');
    for (let [key, value] of googleFormData.entries()) {
      console.log(`${key}: "${value}"`);
    }
    
    // Try with URLSearchParams instead of FormData for better compatibility
    const urlParams = new URLSearchParams();
    for (let [key, value] of googleFormData.entries()) {
      urlParams.append(key, value);
    }
    
    console.log('\nSubmitting as URL encoded data:', urlParams.toString());
    
    // Try alternative method: Create a hidden form and submit it to Google Forms
    try {
      const hiddenForm = document.createElement('form');
      hiddenForm.method = 'POST';
      hiddenForm.action = googleFormURL;
      hiddenForm.target = 'hidden_iframe';
      hiddenForm.style.display = 'none';
      
      // Create hidden iframe to catch the response
      let iframe = document.getElementById('hidden_iframe');
      if (!iframe) {
        iframe = document.createElement('iframe');
        iframe.name = 'hidden_iframe';
        iframe.id = 'hidden_iframe';
        iframe.style.display = 'none';
        document.body.appendChild(iframe);
      }
      
      // Add all form fields as hidden inputs
      for (let [key, value] of googleFormData.entries()) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = key;
        input.value = value;
        hiddenForm.appendChild(input);
      }
      
      document.body.appendChild(hiddenForm);
      
      // Set up iframe onload handler
      iframe.onload = function() {
        console.log('Form submitted to Google Forms via iframe');
        showSuccessMessage();
        form.reset();
        document.getElementById('submitBtn').disabled = false;
        document.getElementById('submitBtn').textContent = 'Submit Application';
        
        // Clean up
        if (document.body.contains(hiddenForm)) {
          document.body.removeChild(hiddenForm);
        }
      };
      
      console.log('Submitting form via hidden iframe method...');
      hiddenForm.submit();
      
    } catch (error) {
      console.error('Error with iframe submission, falling back to fetch:', error);
      
      // Fallback to fetch method
      fetch(googleFormURL, {
        method: 'POST',
        mode: 'no-cors',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: urlParams
      })
      .then(() => {
        console.log('Form submitted successfully via fetch fallback');
        showSuccessMessage();
        form.reset();
        document.getElementById('submitBtn').disabled = false;
        document.getElementById('submitBtn').textContent = 'Submit Application';
      })
      .catch((fetchError) => {
        console.error('Error with fetch submission:', fetchError);
        
        // Still show success since we can't tell with no-cors
        showSuccessMessage();
        form.reset();
        document.getElementById('submitBtn').disabled = false;
        document.getElementById('submitBtn').textContent = 'Submit Application';
      });
    }
  }

  // Show success message
  function showSuccessMessage() {
    const successModal = document.getElementById('successMessage');
    if (successModal) {
      successModal.classList.remove('hidden');
      // Focus on the modal for accessibility
      successModal.setAttribute('tabindex', '-1');
      successModal.focus();
    }
  }

  // Close success message
  function closeSuccessMessage() {
    const successModal = document.getElementById('successMessage');
    if (successModal) {
      successModal.classList.add('hidden');
    }
  }

  // Make closeSuccessMessage globally available
  window.closeSuccessMessage = closeSuccessMessage;

  // Close success message on outside click
  document.addEventListener('click', function(e) {
    const successModal = document.getElementById('successMessage');
    if (successModal && e.target === successModal) {
      closeSuccessMessage();
    }
  });

  // Close success message on escape key
  document.addEventListener('keydown', function(e) {
    const successModal = document.getElementById('successMessage');
    if (e.key === 'Escape' && successModal && !successModal.classList.contains('hidden')) {
      closeSuccessMessage();
    }
  });
</script>
</PageLayout>