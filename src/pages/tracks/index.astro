---
import PageLayout from '../../components/PageLayout.astro';
import { getCollection } from 'astro:content';

const tracks = await getCollection('tracks');
const sortedTracks = tracks.sort((a, b) => a.data.order - b.data.order);

// Helper function for proper URLs
const baseUrl = import.meta.env.BASE_URL || '/';
const createUrl = (path: string) => {
  if (path === '/') return baseUrl;
  // Ensure baseUrl ends with slash before adding path
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  return normalizedBase + path;
};
---

<PageLayout 
  title="Learning Tracks" 
  description="Explore our comprehensive data science and AI learning tracks. From foundations to advanced specializations, find the perfect path for your career goals."
  pageTitle="Learning Tracks"
  pageSubtitle="Choose your path from 8 specialized tracks designed to take you from beginner to expert"
>

    <!-- Tracks Grid -->
    <section class="section-padding bg-white">
      <div class="section-container">
        <div class="grid gap-8 lg:gap-12">
          {sortedTracks.map((track) => (
            <div class="card-elevated bg-white border-secondary-200 overflow-hidden">
              <div class="lg:flex">
                <!-- Track Info -->
                <div class="lg:w-2/3 p-8">
                  <div class="flex items-center gap-4 mb-4">
                    <div class={`px-4 py-2 rounded-full text-sm font-bold text-white ${
                      track.data.level === 'foundation' ? 'bg-green-500' :
                      track.data.level === 'specialization' ? 'bg-orange-500' : 'bg-purple-600'
                    }`}>
                      {track.data.level.charAt(0).toUpperCase() + track.data.level.slice(1)}
                    </div>
                    <div class="bg-primary-600 text-white px-4 py-2 rounded-full text-sm font-medium">
                      {track.data.duration}
                    </div>
                  </div>
                  
                  <h2 class="text-2xl lg:text-3xl font-heading font-bold text-secondary-900 mb-4">
                    {track.data.title}
                  </h2>
                  
                  <p class="text-secondary-700 text-lg mb-6 leading-relaxed">
                    {track.data.description}
                  </p>
                  
                  {track.data.capstone && (
                    <div class="mb-6">
                      <div class="inline-block bg-gradient-to-r from-red-400 to-orange-400 text-white px-4 py-2 rounded-full text-sm font-bold shadow-lg">
                        Capstone: {track.data.capstone}
                      </div>
                    </div>
                  )}
                  
                  <div class="flex flex-col sm:flex-row gap-4">
                    <a href={createUrl(`/tracks/${track.slug}`)} class="btn-primary">
                      View Details
                    </a>
                    <a href={createUrl('/enroll')} class="btn-secondary">
                      Enroll Now
                    </a>
                  </div>
                </div>
                
                <!-- Track Outcomes -->
                <div class="lg:w-1/3 bg-secondary-50 p-8">
                  <h3 class="text-lg font-heading font-semibold text-secondary-900 mb-4">
                    Key Outcomes
                  </h3>
                  <ul class="space-y-3">
                    {track.data.outcomes.map((outcome) => (
                      <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-secondary-700">{outcome}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-br from-primary-600 to-primary-700 section-padding text-white text-center">
      <div class="section-container">
        <h2 class="text-3xl lg:text-4xl font-heading font-bold mb-6">
          Ready to Start Your Learning Journey?
        </h2>
        <p class="text-xl mb-8 text-white/90 max-w-2xl mx-auto">
          Choose the track that matches your career goals and start building your future today.
        </p>
        <a href={createUrl('/enroll')} class="btn-primary bg-white text-primary-600 hover:bg-neutral-50 text-lg px-10 py-5 shadow-glow-lg">
          Enroll in Any Track
        </a>
      </div>
    </section>
  </main>
</PageLayout>