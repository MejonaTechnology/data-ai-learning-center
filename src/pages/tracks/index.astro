---
import PageLayout from '../../components/PageLayout.astro';
import { getCollection } from 'astro:content';

const tracks = await getCollection('tracks');
const sortedTracks = tracks.sort((a, b) => a.data.order - b.data.order);

// Helper function for proper URLs
const baseUrl = import.meta.env.BASE_URL || '/';
const createUrl = (path: string) => {
  if (path === '/') return baseUrl;
  // Ensure baseUrl ends with slash before adding path
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
  return normalizedBase + path;
};
---

<PageLayout 
  title="Learning Tracks" 
  description="Explore our comprehensive data science and AI learning tracks. From foundations to advanced specializations, find the perfect path for your career goals."
  pageTitle="Learning Tracks"
  pageSubtitle="Choose your path from 8 specialized tracks designed to take you from beginner to expert"
>

    <!-- Tracks Grid -->
    <section class="section-padding bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50">
      <div class="section-container">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
          {sortedTracks.map((track) => (
            <div class="group relative bg-white/80 backdrop-blur-xl border border-white/50 rounded-3xl p-8 shadow-2xl hover:shadow-3xl transition-all duration-500 hover:scale-105 hover:bg-white/90 overflow-hidden">
              
              <!-- Background Gradient -->
              <div class={`absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-3xl ${
                track.data.level === 'foundation' ? 'bg-gradient-to-br from-green-500/5 via-transparent to-blue-500/5' :
                track.data.level === 'specialization' ? 'bg-gradient-to-br from-orange-500/5 via-transparent to-red-500/5' : 
                'bg-gradient-to-br from-purple-500/5 via-transparent to-indigo-500/5'
              }`}></div>
              
              <div class="relative">
                <!-- Header -->
                <div class="flex items-center justify-between mb-6">
                  <div class={`w-16 h-16 rounded-2xl flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-300 ${
                    track.data.level === 'foundation' ? 'bg-gradient-to-br from-green-500 to-blue-600 shadow-green-500/25' :
                    track.data.level === 'specialization' ? 'bg-gradient-to-br from-orange-500 to-red-600 shadow-orange-500/25' : 
                    'bg-gradient-to-br from-purple-600 to-indigo-700 shadow-purple-500/25'
                  }`}>
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                  </div>
                  
                  <div class="text-right">
                    <div class={`inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-sm font-bold shadow-lg ${
                      track.data.level === 'foundation' ? 'bg-green-500/10 text-green-700 border border-green-200/50' :
                      track.data.level === 'specialization' ? 'bg-orange-500/10 text-orange-700 border border-orange-200/50' : 
                      'bg-purple-500/10 text-purple-700 border border-purple-200/50'
                    }`}>
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                      </svg>
                      {track.data.duration}
                    </div>
                  </div>
                </div>
                
                <!-- Title & Level -->
                <div class="mb-6">
                  <div class={`inline-block px-4 py-2 rounded-xl text-xs font-bold text-white mb-4 ${
                    track.data.level === 'foundation' ? 'bg-green-500' :
                    track.data.level === 'specialization' ? 'bg-orange-500' : 'bg-purple-600'
                  }`}>
                    {track.data.level.charAt(0).toUpperCase() + track.data.level.slice(1)} Level
                  </div>
                  
                  <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-blue-700 transition-colors">
                    {track.data.title}
                  </h3>
                  
                  <p class="text-slate-600 leading-relaxed text-sm">
                    {track.data.description}
                  </p>
                </div>
                
                <!-- Key Outcomes -->
                <div class="mb-8">
                  <h4 class="text-sm font-semibold text-slate-900 mb-4">Key Outcomes:</h4>
                  <div class="space-y-2">
                    {track.data.outcomes.slice(0, 3).map((outcome) => (
                      <div class="flex items-start gap-3">
                        <div class={`w-2 h-2 rounded-full mt-2 flex-shrink-0 ${
                          track.data.level === 'foundation' ? 'bg-green-500' :
                          track.data.level === 'specialization' ? 'bg-orange-500' : 'bg-purple-600'
                        }`}></div>
                        <span class="text-slate-600 text-sm leading-relaxed">{outcome}</span>
                      </div>
                    ))}
                    {track.data.outcomes.length > 3 && (
                      <div class="text-slate-500 text-xs ml-5">
                        +{track.data.outcomes.length - 3} more outcomes
                      </div>
                    )}
                  </div>
                </div>
                
                <!-- Capstone Project -->
                {track.data.capstone && (
                  <div class="mb-8">
                    <div class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-red-500 text-white px-4 py-2 rounded-2xl text-sm font-bold shadow-lg shadow-orange-500/25">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                      </svg>
                      Capstone Project
                    </div>
                  </div>
                )}
                
                <!-- Action Button -->
                <div class="flex justify-center">
                  <a href={createUrl(`/tracks/${track.slug}`)} 
                     class="group/btn inline-flex items-center justify-center gap-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold px-8 py-4 rounded-2xl transition-all duration-300 shadow-2xl hover:shadow-blue-500/25 hover:scale-105 transform text-sm">
                    <span>Explore Track</span>
                    <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-br from-primary-600 to-primary-700 section-padding text-white text-center">
      <div class="section-container">
        <h2 class="text-3xl lg:text-4xl font-heading font-bold mb-6">
          Ready to Start Your Learning Journey?
        </h2>
        <p class="text-xl mb-8 text-white/90 max-w-2xl mx-auto">
          Choose the track that matches your career goals and start building your future today.
        </p>
        <a href={createUrl('/enroll')} class="btn-primary bg-white text-primary-600 hover:bg-neutral-50 text-lg px-10 py-5 shadow-glow-lg">
          Enroll in Any Track
        </a>
      </div>
    </section>
  </main>
</PageLayout>